      var cancelBtn = document.getElementById('confirm-cancel-btn');
      var okBtn = document.getElementById('confirm-ok-btn');
      cancelBtn.style.display = '';
      okBtn.innerText = 'Tak';
      cancelBtn.innerText = 'Anuluj';
      function sprzatnij(wynik) {
        okBtn.onclick = null;
        cancelBtn.onclick = null;
        zamknijModal('modal-confirm');
        resolve(wynik);
      }
      okBtn.onclick = function () { sprzatnij(true); };
      cancelBtn.onclick = function () { sprzatnij(false); };
      otworzModal('modal-confirm');
    });
  }

  function pokazKomunikat(tekst) {
    return new Promise(function (resolve) {
      document.getElementById('confirm-message').innerText = tekst;
      var cancelBtn = document.getElementById('confirm-cancel-btn');
      var okBtn = document.getElementById('confirm-ok-btn');
      cancelBtn.style.display = 'none';
      okBtn.innerText = 'OK';
      function sprzatnij() {
        okBtn.onclick = null;
        zamknijModal('modal-confirm');
        cancelBtn.style.display = '';
        resolve();
      }
      okBtn.onclick = sprzatnij;
      otworzModal('modal-confirm');
    });
  }

  async function zaloguj() {
    const email = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value;
    const errEl = document.getElementById('login-error');
    errEl.style.display = 'none';
    if (!sb) {
      pokazBladLoginu('Nie udało się połączyć z Supabase. Odśwież stronę (Ctrl+F5) i spróbuj ponownie.');
      return;
    }
    if (!email || !password) {
      pokazBladLoginu('Podaj e-mail i hasło.');
      return;
    }
    var btn = document.querySelector('.login-box .btn.primary');
    if (btn) { btn.disabled = true; btn.innerText = 'Loguję…'; }
    try {
      const { error } = await sb.auth.signInWithPassword({ email, password });
      if (error) {
        pokazBladLoginu('Błąd logowania: ' + error.message);
        return;
      }
      pokazAplikacje();
    } catch (e) {
      console.error(e);
      pokazBladLoginu('Nie udało się połączyć z serwerem logowania: ' + e.message);
    } finally {
      if (btn) { btn.disabled = false; btn.innerText = 'Zaloguj się'; }
    }
  }

  async function wyloguj() {
    await sb.auth.signOut();
    location.reload();
  }

  function pokazAplikacje() {
    document.getElementById('login-screen').classList.add('hidden');
    document.getElementById('app-root').classList.add('ready');
    inicjalizujAplikacje();
    setTimeout(dopasujWysokoscNaglowka, 30);
    window.addEventListener('resize', dopasujWysokoscNaglowka);
  }

  function dopasujWysokoscNaglowka() {
    var header = document.querySelector('#app-root > header');
    if (!header) return;
    var h = header.offsetHeight;
    document.querySelectorAll('.sticky-controls-view').forEach(function (el) {
      el.style.top = h + 'px';
    });
  }

  window.addEventListener('load', async () => {
    if (!sb) return;
    const { data: { session } } = await sb.auth.getSession();
    if (session) {
      pokazAplikacje();
    } else {
      document.getElementById('login-password').addEventListener('keydown', e => {
        if (e.key === 'Enter') zaloguj();
      });
    }
  });

  var state = {
    przepisy: [],
    skladniki: [],
    osoby: [],
    plan: [],
    selectedDate: formatDate(new Date()),
    baseDate: new Date(),
    editingRecipeId: null,
    pickingSlot: null,
    filtrPrzepisy: 'wszystkie',
    iloscPosilkowDaty: {},
    nazwyPosilkow: wczytajNazwyPosilkow(),
    dzisiajPlan: [],
    tydzienPlan: [],
    tydzienStart: formatDate(getPoniedzialek(new Date())),
    zakupyDodatkowe: [],
    domyslnaLiczbaPosilkow: wczytajDomyslnaLiczbePosilkow(),
    wagaOsoba: null,
    wagaPomiary: []
  };
  var currentRecipeId = null;
  var TYPY_POSILKOW = ['śniadanie', 'obiad', 'kolacja', 'przekąska'];

  var PALETA_OSOB = [
    { accent: '#4A4238', bg: '#EDE8DC', nazwa: 'Olive Night' },
    { accent: '#8C8265', bg: '#F1EDE0', nazwa: 'Pelican' },
    { accent: '#2F4735', bg: '#E3E9E0', nazwa: 'Mountain View' },
    { accent: '#4B4139', bg: '#EFEAE2', nazwa: 'Wren' }
  ];

  function paletaOsoby(imieOsoby) {
    var idx = state.osoby.findIndex(function (o) { return o.imie === imieOsoby; });
    if (idx < 0) idx = 0;
    return PALETA_OSOB[idx % PALETA_OSOB.length];
  }

  function wczytajNazwyPosilkow() {
    try {
      var raw = localStorage.getItem('nazwyPosilkow');
      return raw ? JSON.parse(raw) : {};
    } catch (e) { return {}; }
  }

  function zapiszNazwyPosilkow() {
    try { localStorage.setItem('nazwyPosilkow', JSON.stringify(state.nazwyPosilkow)); } catch (e) {}
  }

  function wczytajDomyslnaLiczbePosilkow() {
    try {
      var v = localStorage.getItem('domyslnaLiczbaPosilkow');
      return v ? Number(v) : 3;
    } catch (e) { return 3; }
  }

  function zapiszDomyslnaLiczbePosilkow() {
    var v = document.getElementById('ustawienia-domyslna-liczba').value;
    state.domyslnaLiczbaPosilkow = Number(v);
    try { localStorage.setItem('domyslnaLiczbaPosilkow', v); } catch (e) {}
  }

  function nazwaSlotu(numer) {
    return (state.nazwyPosilkow && state.nazwyPosilkow[numer]) || ('Posiłek ' + numer);
  }

  var renameNumerPosilku = null;

  function zmienNazweSlotu(numer) {
    renameNumerPosilku = numer;
    var obecna = state.nazwyPosilkow[numer] || '';
    var input = document.getElementById('rename-input');
    input.value = obecna;
    otworzModal('modal-rename');
    setTimeout(function () { input.focus(); }, 50);
  }

  function zapiszNazweSlotuZModala() {
    var input = document.getElementById('rename-input');
    var nowa = input.value.trim();
    if (nowa) {
      state.nazwyPosilkow[renameNumerPosilku] = nowa;
    } else {
      delete state.nazwyPosilkow[renameNumerPosilku];
    }
    zapiszNazwyPosilkow();
    zamknijModal('modal-rename');
    renderujPlanDnia();
  }

  function formatDate(d) {
    var y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), day = String(d.getDate()).padStart(2,'0');
    return y + '-' + m + '-' + day;
  }

  function getPoniedzialek(d) {
    var dzien = d.getDay();
    var diff = (dzien === 0 ? -6 : 1 - dzien);
    var poniedzialek = new Date(d);
    poniedzialek.setDate(d.getDate() + diff);
    return poniedzialek;
  }

  function miniaturaPrzepisuHtml(p) {
    if (p && p.zdjecieUrl) {
      return '<img class="recipe-thumb" src="' + p.zdjecieUrl + '" alt="">';
    }
    return '<span class="type-icon"><span class="material-symbols-outlined">' + ikonaTypu(p && p.typPosilku) + '</span></span>';
  }

  function ikonaTypu(typ) {
    switch (typ) {
      case 'śniadanie': return 'breakfast_dining';
      case 'obiad': return 'lunch_dining';
      case 'kolacja': return 'dinner_dining';
      case 'przekąska': return 'cookie';
      default: return 'restaurant';
    }
  }

  function inicjalizujAplikacje() {
    db.getOsoby().then(function (r) { state.osoby = r; renderujWszystko(); }).catch(pokazBlad);
    db.getSkladniki().then(function (r) { state.skladniki = r; }).catch(pokazBlad);
    db.getPrzepisy().then(function (r) {
      state.przepisy = r;
      renderujFiltrPrzepisow();
      renderujPrzepisy();
      wczytajPlanTygodnia();
    }).catch(pokazBlad);

    document.getElementById('skocz-do-daty').value = formatDate(new Date());
    zbudujDayScroller();

    var dzis = new Date();
    document.getElementById('zakupy-od').value = formatDate(dzis);
    var za7 = new Date(dzis); za7.setDate(za7.getDate() + 6);
    document.getElementById('zakupy-do').value = formatDate(za7);

    document.getElementById('rename-input').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') zapiszNazweSlotuZModala();
    });

    wczytajZakupyDodatkowe();
  }

  function renderujWszystko() {
    renderujPlanDnia();
  }

  function pokazWidok(nazwa) {
    document.querySelectorAll('.view').forEach(function (v) { v.classList.remove('active'); });
    document.querySelectorAll('.tab').forEach(function (t) { t.classList.remove('active'); });
    document.getElementById('view-' + nazwa).classList.add('active');
    event.currentTarget.classList.add('active');
    var titles = { plan: 'Plan tygodnia', dzisiaj: 'Dzisiaj', tydzien: 'Podgląd tygodnia', przepisy: 'Przepisy', zakupy: 'Lista zakupów', waga: 'Waga' };
    document.getElementById('page-title').innerText = titles[nazwa];
    document.getElementById('fab-add').style.display = (nazwa === 'przepisy') ? 'block' : 'none';
    if (nazwa === 'dzisiaj') wczytajDzisiaj();
    if (nazwa === 'tydzien') wczytajTydzien();
    if (nazwa === 'zakupy') wczytajZakupyDodatkowe();
    if (nazwa === 'waga') inicjalizujWagaTab();
  }

  function otworzModal(id) { document.getElementById(id).classList.add('open'); }
  function zamknijModal(id) { document.getElementById(id).classList.remove('open'); }

  function zbudujDayScroller() {
    var el = document.getElementById('day-scroller');
    el.innerHTML = '';
    var dni = ['nd','pn','wt','śr','cz','pt','sb'];
    var baza = state.baseDate;
    for (var i = 0; i < 14; i++) {
      var d = new Date(baza); d.setDate(d.getDate() + i);
      var iso = formatDate(d);
      var chip = document.createElement('button');
      chip.className = 'day-chip' + (iso === state.selectedDate ? ' active' : '');
      chip.innerText = dni[d.getDay()] + ' ' + d.getDate() + '/' + (d.getMonth()+1);
      chip.onclick = function (isoVal) {
        return function () {
          state.selectedDate = isoVal;
          zbudujDayScroller();
          renderujPlanDnia();
        };
      }(iso);
      el.appendChild(chip);
    }
  }

  function wczytajPlanTygodnia() {
    var od = formatDate(state.baseDate);
    var doD = new Date(state.baseDate); doD.setDate(doD.getDate() + 13);
    db.getPlanZakresuRaw(od, formatDate(doD)).then(function (rows) {
      state.plan = mapPlanRows(rows);
      renderujPlanDnia();
    }).catch(pokazBlad);
  }

  function skoczDoDaty(iso) {
    if (!iso) return;
    var d = new Date(iso + 'T00:00:00');
    state.baseDate = d;
    state.selectedDate = iso;
    zbudujDayScroller();
    wczytajPlanTygodnia();
  }

  function istniejeWpisDlaNumeru(numerPosilku) {
    return state.plan.some(function (p) {
      return p.data === state.selectedDate && String(p.numerPosilku) === String(numerPosilku) && p.przepis;
    });
  }

  function iloscPosilkowDlaDnia(data) {
    if (state.iloscPosilkowDaty.hasOwnProperty(data)) return state.iloscPosilkowDaty[data];
    if (istniejeWpisDlaNumeru(4)) return 4;
    return state.domyslnaLiczbaPosilkow || 3;
  }

  function renderujPlanDnia() {
    var container = document.getElementById('plan-cards');
    if (!state.osoby.length) { container.innerHTML = '<div class="loading">Wczytywanie…</div>'; return; }
    container.innerHTML = '';

    var liczbaPosilkow = iloscPosilkowDlaDnia(state.selectedDate);
    var numeryPosilkow = [];
    for (var i = 1; i <= liczbaPosilkow; i++) numeryPosilkow.push(i);

    var podsumowania = {};
    state.osoby.forEach(function (o) { podsumowania[o.imie] = { kcal: 0, b: 0, t: 0, w: 0 }; });

    numeryPosilkow.forEach(function (numerPosilku) {
      var header = document.createElement('div');
      header.className = 'meal-slot-header';
      var pokazUsun = numeryPosilkow.length > 1 && numerPosilku === numeryPosilkow.length;
      header.innerHTML =
        '<span class="label-sm card-title-row" style="gap:4px;">' + nazwaSlotu(numerPosilku) +
        '<button class="icon-btn" title="Zmień nazwę tego posiłku"><span class="material-symbols-outlined">edit</span></button></span>' +
        (pokazUsun ? '<button class="icon-btn" title="Usuń ten posiłek z tego dnia"><span class="material-symbols-outlined">delete</span></button>' : '');
      header.querySelector('.icon-btn').onclick = function () { zmienNazweSlotu(numerPosilku); };
      if (pokazUsun) {
        header.querySelectorAll('.icon-btn')[1].onclick = function () { usunOstatniPosilek(); };
      }
      container.appendChild(header);

      state.osoby.forEach(function (osoba) {
        var wpis = state.plan.find(function (p) {
          return p.data === state.selectedDate && p.osoba === osoba.imie && String(p.numerPosilku) === String(numerPosilku);
        });
        var paleta = paletaOsoby(osoba.imie);
        var card = document.createElement('div');
        card.className = 'card osoba-card';
        card.style.borderLeftColor = paleta.accent;
        card.onclick = function () { otworzWyborPrzepisu(state.selectedDate, osoba.imie, numerPosilku); };

        var pill = '<span class="osoba-pill" style="background:' + paleta.bg + ';color:' + paleta.accent + '">' + osoba.imie + '</span>';

        if (wpis && wpis.przepis) {
          var p = wpis.przepis;
          var porcje = wpis.porcje || 1;
          if (podsumowania[osoba.imie]) {
            podsumowania[osoba.imie].kcal += p.kcal * porcje;
            podsumowania[osoba.imie].b += p.bialko * porcje;
            podsumowania[osoba.imie].t += p.tluszcz * porcje;
            podsumowania[osoba.imie].w += p.wegle * porcje;
          }
          card.innerHTML =
            '<div class="row-top"><span class="label-sm card-title-row">' + miniaturaPrzepisuHtml(p) + pill + '</span>' +
            '<span class="row-top-actions"><span class="badge-kcal">' + Math.round(p.kcal * porcje) + ' kcal</span>' +
            '<button class="clear-slot-btn" title="Usuń przepis z tego posiłku"><span class="material-symbols-outlined">close</span></button></span></div>' +
            '<p class="meal-title">' + p.nazwa + '</p>';

          (function (osobaImie, numer) {
            card.querySelector('.clear-slot-btn').onclick = async function (e) {
              e.stopPropagation();
              var ok = await pokazPotwierdzenie('Usunąć przepis z tego posiłku?');
              if (!ok) return;
              wyczyscPosilek(state.selectedDate, osobaImie, numer);
            };
          })(osoba.imie, numerPosilku);

          var stepper = document.createElement('div');
          stepper.className = 'porcje-row';
          stepper.onclick = function (e) { e.stopPropagation(); };
          var btnMinus = document.createElement('button');
          btnMinus.className = 'porcje-btn';
          btnMinus.disabled = porcje <= 1;
          btnMinus.innerHTML = '<span class="material-symbols-outlined">remove</span>';
          var btnPlus = document.createElement('button');
          btnPlus.className = 'porcje-btn';
          btnPlus.disabled = porcje >= 10;
          btnPlus.innerHTML = '<span class="material-symbols-outlined">add</span>';
          (function (osobaImie, numer, idPrzepisu) {
            btnMinus.onclick = function (e) { e.stopPropagation(); zmienPorcje(state.selectedDate, osobaImie, numer, idPrzepisu, -1); };
            btnPlus.onclick = function (e) { e.stopPropagation(); zmienPorcje(state.selectedDate, osobaImie, numer, idPrzepisu, 1); };
          })(osoba.imie, numerPosilku, p.id);
          var label = document.createElement('span');
          label.className = 'label-sm';
          label.innerText = 'Porcje:';
          var val = document.createElement('span');
          val.className = 'porcje-val';
          val.innerText = porcje;
          stepper.appendChild(label);
          stepper.appendChild(btnMinus);
          stepper.appendChild(val);
          stepper.appendChild(btnPlus);
          card.appendChild(stepper);
        } else {
          card.innerHTML =
            '<div class="row-top">' + pill + '</div>' +
            '<div class="empty-slot">+ wybierz przepis</div>';
        }
        container.appendChild(card);
      });
    });

    renderujKontrolkiPlanu(liczbaPosilkow);

    var grid = document.getElementById('summary-grid');
    grid.innerHTML = '';
    state.osoby.forEach(function (o) {
      var s = podsumowania[o.imie] || { kcal: 0, b: 0, t: 0, w: 0 };
      var paleta = paletaOsoby(o.imie);
      var div = document.createElement('div');
      div.className = 'summary-card osoba-card';
      div.style.borderLeftColor = paleta.accent;
      var celHtml = '';
      if (o.celKcal) {
        var proc = Math.max(0, Math.min(100, Math.round((s.kcal / o.celKcal) * 100)));
        celHtml = '<div class="progress-bar-track"><div class="progress-bar-fill" style="width:' + proc + '%; background:' + paleta.accent + ';"></div></div>' +
          '<div class="macro" style="margin-top:4px;">' + Math.round(s.kcal) + ' / ' + o.celKcal + ' kcal</div>';
      }
      div.innerHTML =
        '<div class="label-sm" style="color:' + paleta.accent + '; font-weight:600;">' + o.imie + ' · razem</div>' +
        '<div class="num">' + Math.round(s.kcal) + ' kcal</div>' +
        '<div class="macro">B ' + Math.round(s.b) + 'g · T ' + Math.round(s.t) + 'g · W ' + Math.round(s.w) + 'g</div>' +
        celHtml;
      grid.appendChild(div);
    });
  }

  function renderujKontrolkiPlanu(liczbaPosilkow) {
    var el = document.getElementById('plan-controls-row');
    el.innerHTML = '';
    if (liczbaPosilkow > 1) {
      var btnUsun = document.createElement('button');
      btnUsun.className = 'link-btn remove';
      btnUsun.innerHTML = '<span class="material-symbols-outlined">remove_circle</span>Usuń ostatni posiłek';
      btnUsun.onclick = usunOstatniPosilek;
      el.appendChild(btnUsun);
    }
    if (liczbaPosilkow < 4) {
      var btnDodaj = document.createElement('button');
      btnDodaj.className = 'link-btn';
      btnDodaj.innerHTML = '<span class="material-symbols-outlined">add_circle</span>Dodaj kolejny posiłek';
      btnDodaj.onclick = dodajKolejnyPosilek;
      el.appendChild(btnDodaj);
    }
  }

  function dodajKolejnyPosilek() {
    var aktualna = iloscPosilkowDlaDnia(state.selectedDate);
    if (aktualna >= 4) return;
    state.iloscPosilkowDaty[state.selectedDate] = aktualna + 1;
    renderujPlanDnia();
  }

  async function usunOstatniPosilek() {
    var aktualna = iloscPosilkowDlaDnia(state.selectedDate);
    if (aktualna <= 1) return;
    var numerDoUsuniecia = aktualna;
    var data = state.selectedDate;
    var maPrzypisane = istniejeWpisDlaNumeru(numerDoUsuniecia);

    if (maPrzypisane) {
      var ok = await pokazPotwierdzenie('Do tego posiłku przypisane są przepisy. Usunięcie posiłku wyczyści te przypisania. Kontynuować?');
      if (!ok) return;
    }

    function zmniejszLiczbePosilkow() {
      state.iloscPosilkowDaty[data] = aktualna - 1;
      wczytajPlanTygodnia();
    }

    if (!maPrzypisane || !state.osoby.length) {
      zmniejszLiczbePosilkow();
      return;
    }

    Promise.all(state.osoby.map(function (osoba) {
      return db.ustawPosilek({ data: data, osoba: osoba.imie, numerPosilku: numerDoUsuniecia, idPrzepisu: null });
    })).then(zmniejszLiczbePosilkow).catch(pokazBlad);
  }

  function otworzWyborPrzepisu(data, osoba, numerPosilku) {
    state.pickingSlot = { data: data, osoba: osoba, numerPosilku: numerPosilku };
    document.getElementById('wybor-podtytul').innerText = nazwaSlotu(numerPosilku) + ' · ' + osoba;
    document.getElementById('wybor-szukaj').value = '';
    document.getElementById('wybor-filtr-typ').value = 'wszystkie';
    renderujListeWyboru();
    otworzModal('modal-wybor');
    setTimeout(function () {
      var mh = document.querySelector('#modal-wybor .modal-header');
      var sc = document.querySelector('#modal-wybor .sticky-controls-modal');
      if (mh && sc) sc.style.top = mh.offsetHeight + 'px';
    }, 30);
  }

  function renderujListeWyboru() {
    var lista = document.getElementById('wybor-lista');
    var szukaj = (document.getElementById('wybor-szukaj').value || '').trim().toLowerCase();
    var filtrTyp = document.getElementById('wybor-filtr-typ').value;

    var wyniki = state.przepisy.filter(function (p) {
      var pasujeTekst = !szukaj || p.nazwa.toLowerCase().indexOf(szukaj) !== -1;
      var pasujeTyp = filtrTyp === 'wszystkie' || p.typPosilku === filtrTyp;
      return pasujeTekst && pasujeTyp;
    });

    lista.innerHTML = '';
    if (!state.przepisy.length) {
      lista.innerHTML = '<p class="label-sm">Najpierw dodaj jakiś przepis w zakładce Przepisy.</p>';
      return;
    }
    if (!wyniki.length) {
      lista.innerHTML = '<p class="label-sm">Brak przepisów pasujących do wyszukiwania.</p>';
      return;
    }

    var grupy = {};
    wyniki.forEach(function (p) {
      var kat = p.typPosilku || 'inne';
      if (!grupy[kat]) grupy[kat] = [];
      grupy[kat].push(p);
    });
    var kolejnosc = TYPY_POSILKOW.concat(Object.keys(grupy).filter(function (k) { return TYPY_POSILKOW.indexOf(k) === -1; }));

    kolejnosc.forEach(function (kat) {
      if (!grupy[kat]) return;
      var naglowek = document.createElement('div');
      naglowek.className = 'section-title';
      naglowek.style.margin = '10px 0 6px';
      naglowek.innerText = kat;
      lista.appendChild(naglowek);
      grupy[kat].forEach(function (p) {
        var row = document.createElement('div');
        row.className = 'card recipe-card';
        row.style.cursor = 'pointer';
        row.innerHTML =
          '<div class="card-title-row">' + miniaturaPrzepisuHtml(p) +
          '<div><div class="meal-title" style="margin:0">' + p.nazwa + '</div>' +
          '<div class="meta">' + p.typPosilku + '</div></div></div><span class="badge-kcal">' + p.kcal + ' kcal</span>';
        row.onclick = function () { wybierzPrzepisDoPosilku(p.id); };
        lista.appendChild(row);
      });
    });
  }

  function wybierzPrzepisDoPosilku(idPrzepisu) {
    var slot = state.pickingSlot;
