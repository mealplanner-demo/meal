    var container = document.getElementById('przepisy-list');
    var szukaj = (document.getElementById('przepisy-szukaj').value || '').trim().toLowerCase();
    var lista = state.przepisy.filter(function (p) {
      var pasujeTyp = state.filtrPrzepisy === 'wszystkie' || p.typPosilku === state.filtrPrzepisy;
      var pasujeTekst = !szukaj || p.nazwa.toLowerCase().indexOf(szukaj) !== -1;
      return pasujeTyp && pasujeTekst;
    });
