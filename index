  function wczytajDzisiaj() {
    var dzisIso = formatDate(new Date());
    var dni = ['niedziela','poniedziałek','wtorek','środa','czwartek','piątek','sobota'];
    var d = new Date();
    document.getElementById('dzisiaj-data').innerText =
      dni[d.getDay()].charAt(0).toUpperCase() + dni[d.getDay()].slice(1) + ', ' + d.getDate() + '.' + String(d.getMonth()+1).padStart(2,'0') + '.' + d.getFullYear();
    document.getElementById('dzisiaj-lista').innerHTML = '<div class="loading">Wczytywanie…</div>';
    db.getPlanZakresuRaw(dzisIso, dzisIso).then(function (rows) {
      state.dzisiajPlan = mapPlanRows(rows).filter(function (w) { return w.przepis; });
      renderujDzisiaj();
    }).catch(pokazBlad);
  }

  function renderujDzisiaj() {
    var container = document.getElementById('dzisiaj-lista');
    container.innerHTML = '';

    if (!state.dzisiajPlan.length) {
      container.innerHTML = '<p class="label-sm" style="margin-top:20px;">Na dziś nie zaplanowano jeszcze żadnych posiłków.</p>';
      return;
    }

    var wgNumeru = {};
    state.dzisiajPlan.forEach(function (w) {
      if (!wgNumeru[w.numerPosilku]) wgNumeru[w.numerPosilku] = [];
      wgNumeru[w.numerPosilku].push(w);
    });
    var numery = Object.keys(wgNumeru).map(Number).sort(function (a, b) { return a - b; });

    numery.forEach(function (numer) {
      var header = document.createElement('div');
      header.className = 'meal-slot-header';
      header.innerHTML = '<span class="label-sm">' + nazwaSlotu(numer) + '</span>';
      container.appendChild(header);

      var wgPrzepisu = {};
      wgNumeru[numer].forEach(function (w) {
        var key = w.idPrzepisu;
        if (!wgPrzepisu[key]) wgPrzepisu[key] = [];
        wgPrzepisu[key].push(w);
      });

      Object.keys(wgPrzepisu).forEach(function (idPrzepisu) {
        var wpisy = wgPrzepisu[idPrzepisu];
        var p = wpisy[0].przepis;
        var razemPorcje = wpisy.reduce(function (sum, w) { return sum + (w.porcje || 1); }, 0);

        var pills = wpisy.map(function (w) {
          var paleta = paletaOsoby(w.osoba);
          return '<span class="osoba-pill" style="background:' + paleta.bg + ';color:' + paleta.accent + '">' + w.osoba +
            (wpisy.length > 1 || w.porcje > 1 ? ' ×' + w.porcje : '') + '</span>';
        }).join(' ');

        var thumbHtml = p.zdjecieUrl
          ? '<img class="dzisiaj-thumb" src="' + p.zdjecieUrl + '" alt="">'
          : '<span class="dzisiaj-thumb-fallback"><span class="material-symbols-outlined">' + ikonaTypu(p.typPosilku) + '</span></span>';

        var iloscSkladnikow = p.skladniki.length;
        var liniaSkladnikow = '';
        if (iloscSkladnikow) {
          var wierszeSkladnikow = p.skladniki.map(function (s) {
            var ilosc = (Number(s.ilosc) || 0) * razemPorcje;
            return '<div class="dzisiaj-ingredient-line">+ ' + s.nazwa + ' — ' + (Math.round(ilosc * 100) / 100) + ' ' + s.jednostka + '</div>';
          }).join('');
          liniaSkladnikow = '<div class="dzisiaj-ingredients-grid">' + wierszeSkladnikow + '</div>';
        } else {
          liniaSkladnikow = '<div class="dzisiaj-ingredient-line">Brak podanych składników.</div>';
        }

        var card = document.createElement('div');
        card.className = 'card';
        card.style.cursor = 'pointer';
        card.onclick = function (idPrz) { return function () { pokazSzczegoly(idPrz); }; }(p.id);
        card.innerHTML =
          '<div class="dzisiaj-card">' + thumbHtml +
          '<div class="dzisiaj-content">' +
          '<div class="row-top"><span class="label-sm card-title-row" style="flex-wrap:wrap; gap:6px;">' + pills + '</span>' +
          '<span class="badge-kcal">' + Math.round(p.kcal * razemPorcje) + ' kcal</span></div>' +
          '<p class="meal-title" style="margin-top:6px;">' + p.nazwa + (wpisy.length > 1 ? ' <span class="label-sm" style="font-weight:400;">(razem, ' + razemPorcje + ' porcje)</span>' : '') + '</p>' +
          liniaSkladnikow +
          '</div></div>';

        container.appendChild(card);
      });
    });
  }

