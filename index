<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Planer posiłków</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root {
      --bg: #F2EEE5;
      --card: #ffffff;
      --border: #E1D9C7;
      --text: #3E362E;
      --text-2: #7C7263;
      --text-3: #A79C89;
      --accent: #2F4735;
      --accent-bg: #E3E9E0;
      --accent-border: #5B7864;
      --accent-2: #4B4139;
      --danger: #a32d2d;
      --radius: 14px;
    }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      vertical-align: middle;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      padding-bottom: 84px;
      -webkit-font-smoothing: antialiased;
    }
    header {
      padding: 18px 16px 10px;
      position: sticky;
      top: 0;
      background: var(--bg);
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    header h1 { font-size: 20px; font-weight: 600; margin: 0; }
    #logout-btn {
      background: none; border: none; color: var(--text-3); display: inline-flex;
      align-items: center; gap: 4px; font-size: 12px; cursor: pointer;
    }
    #settings-btn {
      background: none; border: none; color: var(--text-3); display: inline-flex;
      align-items: center; justify-content: center; cursor: pointer; padding: 2px;
    }

    .tabbar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      display: flex;
      background: var(--card);
      border-top: 1px solid var(--border);
      padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
      z-index: 10;
    }
    .tab {
      flex: 1;
      text-align: center;
      font-size: 12px;
      color: var(--text-3);
      background: none;
      border: none;
      padding: 6px 0;
      cursor: pointer;
    }
    .tab.active { color: var(--accent); font-weight: 600; }
    .tab .icon { font-size: 20px; display: block; margin-bottom: 2px; }

    .view { display: none; padding: 0 16px 16px; }
    .view.active { display: block; }

    .day-scroller { display: flex; gap: 8px; overflow-x: auto; padding: 4px 0 14px; -webkit-overflow-scrolling: touch; }
    .day-chip {
      flex: 0 0 auto;
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--card);
      font-size: 13px;
      color: var(--text-2);
      cursor: pointer;
      white-space: nowrap;
    }
    .day-chip.active { background: var(--accent); color: white; border-color: var(--accent); }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
      margin-bottom: 10px;
    }
    .card .row-top { display: flex; justify-content: space-between; align-items: center; }
    .label-sm { font-size: 12px; color: var(--text-2); }
    .badge-kcal { font-size: 12px; color: var(--accent); background: var(--accent-bg); padding: 3px 9px; border-radius: 999px; font-weight: 600; }
    .meal-title { font-size: 15px; font-weight: 600; margin: 6px 0 0; }
    .empty-slot { color: var(--text-3); font-size: 14px; text-align: center; padding: 10px 0; }

    .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 6px; }
    .summary-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; }
    .summary-card .num { font-size: 22px; font-weight: 700; margin: 4px 0 2px; }
    .summary-card .macro { font-size: 11.5px; color: var(--text-3); }
    .progress-bar-track { width: 100%; height: 6px; border-radius: 999px; background: var(--border); margin-top: 8px; overflow: hidden; }
    .progress-bar-fill { height: 100%; border-radius: 999px; }
    .ust-osoba-blok { margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
    .ust-osoba-blok:last-child { border-bottom: none; }

    .section-title { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--text-3); margin: 18px 0 8px; font-weight: 600; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      background: var(--card); border: 1px solid var(--border); border-radius: 10px;
      padding: 11px 16px; font-size: 14px; font-weight: 600; color: var(--text);
      cursor: pointer; width: 100%;
    }
    .btn.primary { background: var(--accent); color: white; border-color: var(--accent); }
    .btn.small { width: auto; padding: 7px 12px; font-size: 13px; }

    .recipe-card { display: flex; justify-content: space-between; align-items: center; }
    .recipe-card .meta { font-size: 12px; color: var(--text-2); margin-top: 3px; }

    .fab {
      position: fixed; right: 16px; bottom: 90px; z-index: 8;
      width: 52px; height: 52px; border-radius: 50%;
      background: var(--accent); color: white; font-size: 26px;
      border: none; box-shadow: 0 4px 14px rgba(0,0,0,.18);
    }

    .modal-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4);
      z-index: 20; align-items: flex-end; justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: var(--bg); width: 100%; max-width: 480px;
      border-radius: 18px 18px 0 0; padding: 18px 16px calc(48px + env(safe-area-inset-bottom));
      max-height: 82vh; overflow-y: auto; margin-bottom: 4px;
      position: relative;
    }
    .close-x { background: none; border: none; color: var(--text-3); }

    label { font-size: 12px; color: var(--text-2); display: block; margin: 12px 0 4px; }
    input, select, textarea {
      width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border);
      font-size: 16px; background: var(--card); color: var(--text); font-family: inherit;
    }
    textarea { min-height: 90px; resize: vertical; }

    .ingredient-row { display: flex; gap: 6px; align-items: center; margin-top: 6px; }
    .ingredient-row select { flex: 2; }
    .ingredient-row input { flex: 1; }
    .ingredient-row button { flex: 0 0 auto; background: none; border: none; color: #a32d2d; font-size: 18px; }

    .shopping-cat { margin-bottom: 16px; }
    .shopping-cat h3 { font-size: 13px; text-transform: uppercase; color: var(--text-3); margin: 0 0 6px; letter-spacing: .04em; }
    .shopping-item { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 14px; }
    .shopping-item input[type=checkbox] { width: 18px; height: 18px; }
    .shopping-item.checked span { text-decoration: line-through; color: var(--text-3); }
    .shopping-item .del-btn {
      margin-left: auto; background: none; border: none; color: var(--text-3);
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px; border-radius: 50%; cursor: pointer; padding: 0; flex: 0 0 auto;
    }
    .shopping-item .del-btn:hover { color: var(--danger); background: #f4e6e6; }
    .shopping-item .del-btn .material-symbols-outlined { font-size: 16px; }

    .dodaj-skladnik-row { display: flex; gap: 6px; margin-top: 4px; margin-bottom: 18px; }
    .dodaj-skladnik-row input { flex: 1; }
    .dodaj-skladnik-row input.ilosc-input { flex: 0 0 90px; }
    .dodaj-skladnik-row button {
      flex: 0 0 auto; width: 42px; background: var(--accent); color: #fff; border: none;
      border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    }

    .loading { text-align: center; color: var(--text-3); padding: 30px 0; font-size: 14px; }

    .chip-scroller { display: flex; gap: 8px; overflow-x: auto; padding: 4px 0 14px; -webkit-overflow-scrolling: touch; }
    .filter-chip {
      flex: 0 0 auto; display: inline-flex; align-items: center; gap: 5px;
      padding: 7px 13px; border-radius: 999px; border: 1px solid var(--border);
      background: var(--card); font-size: 13px; color: var(--text-2); cursor: pointer; white-space: nowrap;
    }
    .filter-chip .material-symbols-outlined { font-size: 16px; }
    .filter-chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    .type-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 30px; height: 30px; border-radius: 9px; background: var(--accent-bg);
      color: var(--accent); flex: 0 0 auto;
    }
    .type-icon .material-symbols-outlined { font-size: 18px; }
    .card-title-row { display: flex; align-items: center; gap: 10px; }

    /* ===== ZDJĘCIA PRZEPISÓW ===== */
    .recipe-thumb {
      width: 44px; height: 44px; border-radius: 10px; object-fit: cover;
      flex: 0 0 auto; background: var(--accent-bg);
    }
    .recipe-thumb-hero {
      width: 100%; height: 160px; object-fit: cover; border-radius: var(--radius);
      margin-bottom: 12px; background: var(--accent-bg);
    }
    .f-zdjecie-wrap { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
    .f-zdjecie-preview {
      width: 60px; height: 60px; border-radius: 10px; object-fit: cover;
      background: var(--accent-bg); flex: 0 0 auto; display: none;
    }
    .f-zdjecie-preview.shown { display: block; }
    .f-zdjecie-input-label {
      display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600;
      color: var(--text); background: var(--card); border: 1px solid var(--border);
      border-radius: 10px; padding: 9px 14px; cursor: pointer;
    }
    #f-zdjecie { display: none; }

    /* ===== WIDOK DZISIAJ - karta w stylu listy z miniaturą ===== */
    .dzisiaj-card { display: flex; gap: 12px; align-items: flex-start; }
    .dzisiaj-thumb {
      width: 64px; height: 64px; border-radius: 12px; object-fit: cover;
      flex: 0 0 auto; background: var(--accent-bg);
    }
    .dzisiaj-thumb-fallback {
      width: 64px; height: 64px; border-radius: 12px; flex: 0 0 auto;
      background: var(--accent-bg); color: var(--accent);
      display: flex; align-items: center; justify-content: center;
    }
    .dzisiaj-thumb-fallback .material-symbols-outlined { font-size: 28px; }
    .dzisiaj-content { flex: 1; min-width: 0; }
    .dzisiaj-ingredient-line { font-size: 12.5px; color: var(--text-2); margin-top: 2px; }
    .dzisiaj-ingredients-grid {
      display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; row-gap: 0;
      margin-top: 4px;
    }

    /* ===== WIDOK TYDZIEŃ - siatka kalendarza ===== */
    .cal-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--radius); border: 1px solid var(--border); }
    .cal-table { border-collapse: collapse; width: 100%; background: var(--card); }
    .cal-table th, .cal-table td {
      border: 1px solid var(--border); padding: 8px 7px; font-size: 12px; vertical-align: top;
      min-width: 118px;
    }
    .cal-table th {
      background: var(--card); font-size: 11.5px; text-transform: uppercase; letter-spacing: .03em;
      color: var(--text-2); font-weight: 700; position: sticky; top: 0; z-index: 2;
    }
    .cal-table td.cal-slot-label, .cal-table th.cal-corner {
      position: sticky; left: 0; z-index: 1; background: var(--card);
      font-weight: 600; color: var(--text); min-width: 84px; max-width: 84px;
      font-size: 11.5px;
    }
    .cal-table th.cal-corner { z-index: 3; }
    .cal-table th.cal-today, .cal-table td.cal-today { background: var(--accent-bg); }
    .cal-table th.cal-today { color: var(--accent); }
    .cal-person-line { margin-bottom: 4px; }
    .cal-person-line:last-child { margin-bottom: 0; }
    .cal-person-name { font-weight: 700; }
    .cal-empty { color: var(--text-3); }

    .modal-header {
      position: sticky; top: 0; z-index: 2; background: var(--bg);
      display: flex; align-items: center; justify-content: space-between;
      margin: -18px -16px 14px; padding: 16px 16px 10px; border-radius: 18px 18px 0 0;
    }
    .modal-header h2 { font-size: 17px; margin: 0; }
    .modal-header .close-x {
      position: static; display: inline-flex; align-items: center; justify-content: center;
      width: 32px; height: 32px; border-radius: 50%; background: var(--card);
      border: 1px solid var(--border); color: var(--text-2); font-size: 0; flex: 0 0 auto;
    }

    .sticky-controls-view {
      position: sticky;
      top: 54px;
      z-index: 4;
      background: var(--bg);
      padding-top: 2px;
      margin: 0 -16px;
      padding-left: 16px;
      padding-right: 16px;
    }
    .sticky-controls-modal {
      position: sticky;
      top: 48px;
      z-index: 1;
      background: var(--bg);
      margin: 0 -16px;
      padding: 0 16px 6px;
    }
    .search-row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
    .search-box { position: relative; flex: 1; }
    .search-box .material-symbols-outlined {
      position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-3); font-size: 18px;
    }
    .search-box input { padding-left: 34px; }
    .search-row select { flex: 0 0 128px; }

    .btn-row { display: flex; gap: 8px; margin-top: 16px; }
    .btn-row .btn { margin-top: 0; }
    .btn.ghost { background: transparent; }
    .btn.danger-outline { color: var(--danger); border-color: var(--danger); }

    .plan-controls-row { display: flex; gap: 8px; justify-content: center; margin: 4px 0 14px; }
    .link-btn {
      background: none; border: none; color: var(--accent); font-size: 13px; font-weight: 600;
      display: inline-flex; align-items: center; gap: 4px; cursor: pointer; padding: 6px 10px;
      border-radius: 999px; border: 1px solid var(--border); background: var(--card);
    }
    .link-btn.remove { color: var(--danger); }
    .link-btn .material-symbols-outlined { font-size: 17px; }
    .link-btn:disabled { opacity: .4; cursor: default; }

    .meal-slot-header { display: flex; align-items: center; justify-content: space-between; margin: 14px 0 6px; }
    .meal-slot-header .label-sm { font-weight: 600; color: var(--text); text-transform: uppercase; font-size: 11.5px; letter-spacing: .04em; }
    .meal-slot-header .icon-btn {
      background: none; border: none; color: var(--text-3); display: inline-flex; align-items: center;
      padding: 3px; cursor: pointer;
    }
    .meal-slot-header .icon-btn .material-symbols-outlined { font-size: 18px; }

    .porcje-row { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--border); }
    .porcje-row .label-sm { margin: 0; }
    .porcje-btn {
      width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--border); background: var(--card);
      display: inline-flex; align-items: center; justify-content: center; color: var(--text); cursor: pointer; padding: 0; flex: 0 0 auto;
    }
    .porcje-btn .material-symbols-outlined { font-size: 16px; }
    .porcje-btn:disabled { opacity: .35; cursor: default; }
    .porcje-val { font-weight: 700; font-size: 14px; min-width: 14px; text-align: center; }

    .row-top-actions { display: flex; align-items: center; gap: 6px; }
    .clear-slot-btn {
      background: none; border: none; color: var(--text-3); display: inline-flex; align-items: center;
      justify-content: center; width: 24px; height: 24px; border-radius: 50%; cursor: pointer; padding: 0; flex: 0 0 auto;
    }
    .clear-slot-btn .material-symbols-outlined { font-size: 17px; }
    .clear-slot-btn:hover { color: var(--danger); background: #f4e6e6; }

    .osoba-pill { display: inline-flex; align-items: center; padding: 3px 9px; border-radius: 999px; font-weight: 600; font-size: 11.5px; }
    .card.osoba-card { border-left-width: 4px; border-left-style: solid; }
    .summary-card.osoba-card { border-left-width: 4px; border-left-style: solid; }

    /* ===== EKRAN LOGOWANIA ===== */
    #login-screen {
      position: fixed; inset: 0; background: var(--bg); z-index: 100;
      display: flex; align-items: center; justify-content: center; padding: 24px;
    }
    #login-screen.hidden { display: none; }
    .login-box { width: 100%; max-width: 340px; }
    .login-box h1 { font-size: 22px; margin: 0 0 4px; }
    .login-box p.sub { color: var(--text-2); font-size: 13px; margin: 0 0 22px; }
    #login-error { color: var(--danger); font-size: 13px; margin-top: 10px; display: none; }
    #app-root { display: none; }
    #app-root.ready { display: block; }
  </style>
</head>
<body>

<!-- ===================== EKRAN LOGOWANIA ===================== -->
<div id="login-screen">
  <div class="login-box">
    <h1>Planer posiłków</h1>
    <p class="sub">Zaloguj się, żeby zobaczyć plan.</p>
    <label>E-mail</label>
    <input id="login-email" type="email" autocomplete="username">
    <label>Hasło</label>
    <input id="login-password" type="password" autocomplete="current-password">
    <button class="btn primary" style="margin-top:16px;" onclick="zaloguj()">Zaloguj się</button>
    <div id="login-error"></div>
  </div>
</div>

<div id="app-root">

<header>
  <h1 id="page-title">Plan tygodnia</h1>
  <div style="display:flex; align-items:center; gap:10px;">
    <button id="settings-btn" onclick="otworzUstawienia()" title="Ustawienia"><span class="material-symbols-outlined" style="font-size:20px;">settings</span></button>
    <button id="logout-btn" onclick="wyloguj()"><span class="material-symbols-outlined" style="font-size:16px;">logout</span>Wyloguj</button>
  </div>
</header>

<!-- ===================== WIDOK: PLAN ===================== -->
<div class="view active" id="view-plan">
  <label style="margin-top:0;">Skocz do daty</label>
  <input type="date" id="skocz-do-daty" onchange="skoczDoDaty(this.value)">
  <div class="day-scroller" id="day-scroller" style="margin-top:12px;"></div>
  <div id="plan-cards"><div class="loading">Wczytywanie…</div></div>
  <div class="plan-controls-row" id="plan-controls-row"></div>

  <div class="section-title">Podsumowanie dnia</div>
  <div class="summary-grid" id="summary-grid"></div>
</div>

<!-- ===================== WIDOK: DZISIAJ ===================== -->
<div class="view" id="view-dzisiaj">
  <div class="label-sm" id="dzisiaj-data" style="margin-bottom:10px;"></div>
  <div id="dzisiaj-lista"><div class="loading">Wczytywanie…</div></div>
</div>

<!-- ===================== WIDOK: TYDZIEŃ (PODGLĄD) ===================== -->
<div class="view" id="view-tydzien">
  <div class="plan-controls-row" style="margin-top:0;">
    <button class="link-btn" onclick="tydzienPoprzedni()"><span class="material-symbols-outlined">chevron_left</span>Poprzedni</button>
    <button class="link-btn" onclick="tydzienNastepny()">Następny<span class="material-symbols-outlined">chevron_right</span></button>
  </div>
  <div class="label-sm" id="tydzien-zakres" style="text-align:center; margin-bottom:10px;"></div>
  <div class="cal-scroll"><div id="tydzien-lista"><div class="loading">Wczytywanie…</div></div></div>
</div>

<!-- ===================== WIDOK: PRZEPISY ===================== -->
<div class="view" id="view-przepisy">
  <div class="sticky-controls-view">
    <div class="search-box" style="margin-top:2px; margin-bottom:10px;">
      <span class="material-symbols-outlined">search</span>
      <input id="przepisy-szukaj" placeholder="Szukaj przepisu…" oninput="renderujPrzepisy()">
    </div>
    <div class="chip-scroller" id="przepisy-filter"></div>
  </div>
  <div id="przepisy-list"><div class="loading">Wczytywanie…</div></div>
</div>

<!-- ===================== WIDOK: ZAKUPY ===================== -->
<div class="view" id="view-zakupy">
  <label>Od</label>
  <input type="date" id="zakupy-od">
  <label>Do</label>
  <input type="date" id="zakupy-do">
  <button class="btn primary" style="margin-top:14px" onclick="wczytajListeZakupow()">Pokaż listę zakupów</button>
  <div id="zakupy-wynik" style="margin-top:18px"></div>

  <div class="section-title">Dodatkowe (ręcznie)</div>
  <div class="dodaj-skladnik-row">
    <input id="dodatkowy-nazwa" placeholder="np. papier toaletowy" onkeydown="if(event.key==='Enter') dodajZakupDodatkowy();">
    <input id="dodatkowy-ilosc" class="ilosc-input" placeholder="ilość (opcj.)" onkeydown="if(event.key==='Enter') dodajZakupDodatkowy();">
    <button onclick="dodajZakupDodatkowy()"><span class="material-symbols-outlined">add</span></button>
  </div>
  <div id="zakupy-dodatkowe-wynik"></div>
</div>

<!-- ===================== WIDOK: WAGA ===================== -->
<div class="view" id="view-waga">
  <div class="day-scroller" id="waga-osoby-chips" style="margin-top:4px;"></div>
  <div class="card" id="waga-cel-card"><div class="loading">Wczytywanie…</div></div>

  <div class="section-title">Nowy pomiar</div>
  <div class="dodaj-skladnik-row">
    <input type="date" id="waga-nowa-data">
    <input type="number" step="0.1" inputmode="decimal" class="ilosc-input" id="waga-nowa-wartosc" placeholder="kg">
    <button onclick="dodajPomiarWagiHandler()"><span class="material-symbols-outlined">add</span></button>
  </div>

  <div id="waga-wykres"></div>

  <div class="section-title">Historia</div>
  <div id="waga-lista"><div class="loading">Wczytywanie…</div></div>
</div>

