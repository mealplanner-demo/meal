  function zmienPorcje(data, osobaImie, numerPosilku, idPrzepisu, delta) {
    var wpis = state.plan.find(function (p) {
      return p.data === data && p.osoba === osobaImie && String(p.numerPosilku) === String(numerPosilku);
    });
    var obecne = (wpis && wpis.porcje) || 1;
    var nowe = Math.max(1, Math.min(10, obecne + delta));
    if (nowe === obecne) return;
    db.ustawPosilek({ data: data, osoba: osobaImie, numerPosilku: numerPosilku, idPrzepisu: idPrzepisu, porcje: nowe })
      .then(wczytajPlanTygodnia).catch(pokazBlad);
  }

