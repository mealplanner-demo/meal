  function renderujTydzien() {
    var container = document.getElementById('tydzien-lista');
    container.innerHTML = '';

    var dni = ['nd','pn','wt','śr','cz','pt','sb'];
    var start = new Date(state.tydzienStart + 'T00:00:00');
    var dzisIso = formatDate(new Date());

    var dniInfo = [];
    var maxNumer = 3;
    for (var i = 0; i < 7; i++) {
      var d = new Date(start); d.setDate(d.getDate() + i);
      var iso = formatDate(d);
      var wpisyDnia = state.tydzienPlan.filter(function (w) { return w.data === iso; });
      wpisyDnia.forEach(function (w) { if (w.numerPosilku > maxNumer) maxNumer = w.numerPosilku; });
      dniInfo.push({ d: d, iso: iso, wpisy: wpisyDnia, jestDzis: iso === dzisIso });
    }

    var table = document.createElement('table');
    table.className = 'cal-table';

    var thead = document.createElement('thead');
    var trHead = document.createElement('tr');
    var thCorner = document.createElement('th');
    thCorner.className = 'cal-corner';
    trHead.appendChild(thCorner);
    dniInfo.forEach(function (info) {
      var th = document.createElement('th');
      if (info.jestDzis) th.className = 'cal-today';
      th.innerHTML = dni[info.d.getDay()] + '<br>' + info.d.getDate() + '/' + (info.d.getMonth() + 1);
      trHead.appendChild(th);
    });
    thead.appendChild(trHead);
    table.appendChild(thead);

    var tbody = document.createElement('tbody');
    for (var numer = 1; numer <= maxNumer; numer++) {
      var tr = document.createElement('tr');
      var tdLabel = document.createElement('td');
      tdLabel.className = 'cal-slot-label';
      tdLabel.innerText = nazwaSlotu(numer);
      tr.appendChild(tdLabel);

      dniInfo.forEach(function (info) {
        var td = document.createElement('td');
        if (info.jestDzis) td.className = 'cal-today';
        var liniaHtml = '';
        state.osoby.forEach(function (osoba) {
          var wpis = info.wpisy.find(function (w) {
            return w.osoba === osoba.imie && String(w.numerPosilku) === String(numer);
          });
          var paleta = paletaOsoby(osoba.imie);
          liniaHtml += '<div class="cal-person-line"><span class="cal-person-name" style="color:' + paleta.accent + ';">' + osoba.imie + '</span><br>' +
            (wpis && wpis.przepis ? wpis.przepis.nazwa : '<span class="cal-empty">—</span>') + '</div>';
        });
        td.innerHTML = liniaHtml;
        tr.appendChild(td);
      });

      tbody.appendChild(tr);
    }
    table.appendChild(tbody);
    container.appendChild(table);
  }

