  async function zapiszPrzepis() {
    var nazwa = document.getElementById('f-nazwa').value.trim();
    if (!nazwa) { pokazKomunikat('Podaj nazwę przepisu.'); return; }

    var skladnikiWiersze = Array.from(document.querySelectorAll('#f-skladniki-lista .ingredient-row'));
    var skladniki = skladnikiWiersze.map(function (row) {
      var select = row.querySelector('select');
      var input = row.querySelector('input');
      return { id: select.value, ilosc: Number(input.value) || 0 };
    }).filter(function (s) { return s.id; });

    var zapiszBtn = document.querySelector('#modal-formularz .btn.primary');
    var plikZdjecia = document.getElementById('f-zdjecie').files[0];
    var zdjecieUrl = state.formZdjecieUrl || '';

    try {
      if (plikZdjecia) {
        if (zapiszBtn) { zapiszBtn.disabled = true; zapiszBtn.innerText = 'Przetwarzanie zdjęcia…'; }
        zdjecieUrl = await wyslijZdjeciePrzepisu(plikZdjecia);
      }

      var przepis = {
        id: state.editingRecipeId,
        nazwa: nazwa,
        typPosilku: document.getElementById('f-typ').value,
        kcal: Number(document.getElementById('f-kcal').value) || 0,
        bialko: Number(document.getElementById('f-bialko').value) || 0,
        tluszcz: Number(document.getElementById('f-tluszcz').value) || 0,
        wegle: Number(document.getElementById('f-wegle').value) || 0,
        przygotowanie: document.getElementById('f-przygotowanie').value,
        zdjecieUrl: zdjecieUrl,
        skladniki: skladniki
      };

      if (zapiszBtn) { zapiszBtn.innerText = 'Zapisywanie…'; }
      await db.savePrzepis(przepis);
      zamknijModal('modal-formularz');
      odswiezPrzepisy();
      wczytajPlanTygodnia();
    } catch (e) {
      pokazBlad(e);
    } finally {
      if (zapiszBtn) { zapiszBtn.disabled = false; zapiszBtn.innerText = 'Zapisz przepis'; }
    }
  }

  function wczytajListeZakupow() {
    var od = document.getElementById('zakupy-od').value;
    var doD = document.getElementById('zakupy-do').value;
    if (!od || !doD) { pokazKomunikat('Wybierz zakres dat.'); return; }
    document.getElementById('zakupy-wynik').innerHTML = '<div class="loading">Wczytywanie…</div>';
    db.getPlanZakresuRaw(od, doD).then(function (rows) {
      var plan = mapPlanRows(rows);
      var pogrupowane = obliczListeZakupow(plan);
      renderujListeZakupow(pogrupowane);
    }).catch(pokazBlad);
  }

  function obliczListeZakupow(plan) {
    var suma = {};
    plan.forEach(function (wpis) {
      if (!wpis.przepis) return;
      var porcje = wpis.porcje || 1;
      wpis.przepis.skladniki.forEach(function (s) {
        var key = s.id;
        if (!suma[key]) {
          suma[key] = { nazwa: s.nazwa, kategoria: s.kategoria, jednostka: s.jednostka, ilosc: 0 };
        }
        suma[key].ilosc += (Number(s.ilosc) || 0) * porcje;
      });
    });
    var pogrupowane = {};
    Object.keys(suma).forEach(function (key) {
      var item = suma[key];
      var kat = item.kategoria || 'inne';
      if (!pogrupowane[kat]) pogrupowane[kat] = [];
      pogrupowane[kat].push({ nazwa: item.nazwa, ilosc: item.ilosc, jednostka: item.jednostka });
    });
    return pogrupowane;
  }

  function renderujListeZakupow(pogrupowane) {
    var container = document.getElementById('zakupy-wynik');
    var kategorie = Object.keys(pogrupowane);
    if (!kategorie.length) {
      container.innerHTML = '<p class="label-sm">Brak zaplanowanych posiłków z przypisanymi składnikami w tym zakresie.</p>';
      return;
    }
    container.innerHTML = '';
    kategorie.forEach(function (kat) {
      var block = document.createElement('div');
      block.className = 'shopping-cat';
      var items = pogrupowane[kat].map(function (it) {
        return '<div class="shopping-item" onclick="this.classList.toggle(\'checked\')">' +
          '<input type="checkbox" onclick="event.stopPropagation(); this.parentElement.classList.toggle(\'checked\')">' +
          '<span>' + it.nazwa + ' — ' + (Math.round(it.ilosc * 100) / 100) + ' ' + it.jednostka + '</span></div>';
      }).join('');
      block.innerHTML = '<h3>' + kat + '</h3>' + items;
      container.appendChild(block);
    });
  }

  // ===================== USTAWIENIA / CZYSZCZENIE STAREGO PLANU =====================
  function otworzUstawienia() {
    var input = document.getElementById('ustawienia-data');
    if (!input.value) {
      var miesiacTemu = new Date();
      miesiacTemu.setMonth(miesiacTemu.getMonth() - 1);
      input.value = formatDate(miesiacTemu);
    }
    document.getElementById('ustawienia-domyslna-liczba').value = state.domyslnaLiczbaPosilkow || 3;
    renderujUstawieniaOsoby();
    renderujNieuzywaneSkladniki();
    otworzModal('modal-ustawienia');
  }

  // ===================== OSOBY: EDYCJA IMION I CELÓW =====================
  function renderujUstawieniaOsoby() {
    var el = document.getElementById('ustawienia-osoby-lista');
    el.innerHTML = '';
    state.osoby.forEach(function (o) {
      var blok = document.createElement('div');
      blok.className = 'ust-osoba-blok';
      blok.innerHTML =
        '<label style="margin-top:0;">Imię</label>' +
        '<input type="text" class="ust-osoba-imie" data-id="' + o.id + '" value="' + o.imie + '">' +
        '<label>Cel kalorii (kcal/dzień)</label>' +
        '<input type="number" class="ust-osoba-kcal" data-id="' + o.id + '" value="' + (o.celKcal != null ? o.celKcal : '') + '" placeholder="np. 1800">' +
        '<label>Cel wagi (kg)</label>' +
        '<input type="number" step="0.1" class="ust-osoba-waga" data-id="' + o.id + '" value="' + (o.celWaga != null ? o.celWaga : '') + '" placeholder="np. 70">';
      el.appendChild(blok);
    });
  }

  async function zapiszOsobyZUstawien() {
    var imionaInputs = document.querySelectorAll('.ust-osoba-imie');
    try {
      for (var i = 0; i < imionaInputs.length; i++) {
        var id = imionaInputs[i].getAttribute('data-id');
        var imie = imionaInputs[i].value.trim();
        if (!imie) continue;
        var kcalEl = document.querySelector('.ust-osoba-kcal[data-id="' + id + '"]');
        var wagaEl = document.querySelector('.ust-osoba-waga[data-id="' + id + '"]');
        var celKcal = (kcalEl && kcalEl.value !== '') ? Number(kcalEl.value) : null;
        var celWaga = (wagaEl && wagaEl.value !== '') ? Number(wagaEl.value) : null;
        await db.updateOsobaPelna(id, imie, celKcal, celWaga);
      }
      var r = await db.getOsoby();
      state.osoby = r;
      renderujUstawieniaOsoby();
      renderujWszystko();
      await pokazKomunikat('Zapisano zmiany.');
    } catch (e) {
      pokazBlad(e);
    }
  }

  // ===================== KOPIA ZAPASOWA =====================
  function pobierzKopieZapasowa() {
    try {
      var dane = {
        eksport_z_dnia: new Date().toISOString(),
        osoby: state.osoby,
        skladniki: state.skladniki,
        przepisy: state.przepisy
      };
      var blob = new Blob([JSON.stringify(dane, null, 2)], { type: 'application/json' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'planer-posilkow-kopia-' + formatDate(new Date()) + '.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (e) {
      pokazBlad(e);
    }
  }

  // ===================== NIEUŻYWANE SKŁADNIKI =====================
  function renderujNieuzywaneSkladniki() {
    var el = document.getElementById('ustawienia-nieuzywane-lista');
    var uzywane = {};
    state.przepisy.forEach(function (p) {
      p.skladniki.forEach(function (s) { uzywane[s.id] = true; });
    });
    var nieuzywane = state.skladniki.filter(function (s) { return !uzywane[s.id]; });
    if (!nieuzywane.length) {
      el.innerHTML = '<p class="label-sm">Brak nieużywanych składników.</p>';
      return;
    }
    el.innerHTML = '';
    nieuzywane.forEach(function (s) {
      var row = document.createElement('div');
      row.className = 'shopping-item';
      row.innerHTML =
        '<span>' + s.nazwa + ' <span class="label-sm">(' + s.kategoria + ')</span></span>' +
        '<button class="del-btn" title="Usuń"><span class="material-symbols-outlined">close</span></button>';
      row.querySelector('.del-btn').onclick = async function () {
        var ok = await pokazPotwierdzenie('Usunąć składnik "' + s.nazwa + '" z bazy?');
        if (!ok) return;
        db.deleteSkladnik(s.id).then(async function () {
          var r = await db.getSkladniki();
          state.skladniki = r;
          renderujNieuzywaneSkladniki();
        }).catch(pokazBlad);
      };
      el.appendChild(row);
    });
  }

  async function wyczyscStaryPlan() {
    var dataGraniczna = document.getElementById('ustawienia-data').value;
    if (!dataGraniczna) { pokazKomunikat('Wybierz datę.'); return; }
    try {
      var liczba = await db.policzPlanPrzed(dataGraniczna);
      if (liczba === 0) {
        await pokazKomunikat('Nie znaleziono zaplanowanych posiłków sprzed ' + dataGraniczna + '.');
        return;
      }
      var ok = await pokazPotwierdzenie('Usunąć ' + liczba + ' zaplanowanych posiłków sprzed ' + dataGraniczna + '? Tej operacji nie można cofnąć.');
      if (!ok) return;
      await db.usunPlanPrzed(dataGraniczna);
      zamknijModal('modal-ustawienia');
      wczytajPlanTygodnia();
      await pokazKomunikat('Usunięto ' + liczba + ' zaplanowanych posiłków.');
    } catch (e) {
      pokazBlad(e);
    }
  }

  // ===================== ZAKUPY DODATKOWE (ręcznie dodane) =====================
  function wczytajZakupyDodatkowe() {
    var container = document.getElementById('zakupy-dodatkowe-wynik');
    if (container) container.innerHTML = '<div class="loading">Wczytywanie…</div>';
    db.getZakupyDodatkowe().then(function (r) {
      state.zakupyDodatkowe = r;
      renderujZakupyDodatkowe();
    }).catch(pokazBlad);
  }

  function renderujZakupyDodatkowe() {
    var container = document.getElementById('zakupy-dodatkowe-wynik');
    if (!container) return;
    if (!state.zakupyDodatkowe.length) {
      container.innerHTML = '<p class="label-sm">Brak dodatkowych pozycji.</p>';
      return;
    }
    container.innerHTML = state.zakupyDodatkowe.map(function (it) {
      return '<div class="shopping-item' + (it.kupione ? ' checked' : '') + '" data-id="' + it.id + '">' +
        '<input type="checkbox" ' + (it.kupione ? 'checked' : '') + ' onchange="przelaczKupioneDodatkowy(' + it.id + ', this.checked)">' +
        '<span>' + it.nazwa + (it.ilosc ? ' — ' + it.ilosc : '') + '</span>' +
        '<button class="del-btn" onclick="usunZakupDodatkowyPotwierdz(' + it.id + ')"><span class="material-symbols-outlined">close</span></button>' +
        '</div>';
    }).join('');
  }

  function dodajZakupDodatkowy() {
    var nazwaEl = document.getElementById('dodatkowy-nazwa');
    var iloscEl = document.getElementById('dodatkowy-ilosc');
    var nazwa = nazwaEl.value.trim();
    var ilosc = iloscEl.value.trim();
    if (!nazwa) return;
    db.dodajZakupDodatkowy(nazwa, ilosc).then(function () {
      nazwaEl.value = '';
      iloscEl.value = '';
      nazwaEl.focus();
      wczytajZakupyDodatkowe();
    }).catch(pokazBlad);
  }

  function przelaczKupioneDodatkowy(id, kupione) {
    db.ustawKupioneDodatkowy(id, kupione).then(function () {
      var item = state.zakupyDodatkowe.find(function (z) { return z.id === id; });
      if (item) item.kupione = kupione;
      var el = document.querySelector('.shopping-item[data-id="' + id + '"]');
      if (el) el.classList.toggle('checked', kupione);
    }).catch(pokazBlad);
  }

  async function usunZakupDodatkowyPotwierdz(id) {
    var ok = await pokazPotwierdzenie('Usunąć tę pozycję z listy?');
    if (!ok) return;
    db.usunZakupDodatkowy(id).then(wczytajZakupyDodatkowe).catch(pokazBlad);
  }

  // ===================== WIDOK: WAGA =====================
  function inicjalizujWagaTab() {
    if (!state.wagaOsoba && state.osoby.length) state.wagaOsoba = state.osoby[0].imie;
    if (!document.getElementById('waga-nowa-data').value) {
      document.getElementById('waga-nowa-data').value = formatDate(new Date());
    }
    renderujWagaChipy();
    wczytajWage();
  }

  function renderujWagaChipy() {
    var el = document.getElementById('waga-osoby-chips');
    el.innerHTML = '';
    state.osoby.forEach(function (o) {
      var chip = document.createElement('button');
      chip.className = 'day-chip' + (o.imie === state.wagaOsoba ? ' active' : '');
      chip.innerText = o.imie;
      chip.onclick = function () {
        state.wagaOsoba = o.imie;
        renderujWagaChipy();
        wczytajWage();
      };
      el.appendChild(chip);
    });
  }

  function wczytajWage() {
    if (!state.wagaOsoba) return;
    document.getElementById('waga-lista').innerHTML = '<div class="loading">Wczytywanie…</div>';
    document.getElementById('waga-cel-card').innerHTML = '<div class="loading">Wczytywanie…</div>';
    db.getPomiaryWagi(state.wagaOsoba).then(function (r) {
      state.wagaPomiary = r;
      renderujWage();
    }).catch(pokazBlad);
  }

  function renderujWage() {
    var osoba = state.osoby.find(function (o) { return o.imie === state.wagaOsoba; });
    var celEl = document.getElementById('waga-cel-card');
    var ostatni = state.wagaPomiary.length ? state.wagaPomiary[state.wagaPomiary.length - 1] : null;

    if (!osoba || !osoba.celWaga) {
      celEl.innerHTML =
        '<div class="label-sm">Brak ustawionego celu wagi dla ' + (osoba ? osoba.imie : '') + '.</div>' +
        '<div class="label-sm" style="margin-top:4px;">Ustaw go w Ustawieniach (ikona koła zębatego).</div>' +
        (ostatni ? '<div class="num" style="margin-top:8px;">' + ostatni.waga + ' kg</div>' : '');
    } else if (!ostatni) {
      celEl.innerHTML =
        '<div class="label-sm">Cel: ' + osoba.celWaga + ' kg</div>' +
        '<div class="macro" style="margin-top:4px;">Brak jeszcze żadnych pomiarów.</div>';
    } else {
      var roznica = Number(ostatni.waga) - Number(osoba.celWaga);
      var opis;
      if (Math.abs(roznica) < 0.05) opis = 'Cel osiągnięty 🎉';
      else if (roznica > 0) opis = 'Jeszcze ' + roznica.toFixed(1) + ' kg do celu';
      else opis = 'Poniżej celu o ' + Math.abs(roznica).toFixed(1) + ' kg';
      celEl.innerHTML =
        '<div class="label-sm">Cel: ' + osoba.celWaga + ' kg</div>' +
        '<div class="num" style="margin-top:4px;">' + ostatni.waga + ' kg</div>' +
        '<div class="macro">' + opis + '</div>';
    }

    renderujWykresWagi();

    var lista = document.getElementById('waga-lista');
    if (!state.wagaPomiary.length) {
      lista.innerHTML = '<p class="label-sm">Brak pomiarów.</p>';
      return;
    }
    lista.innerHTML = '';
    state.wagaPomiary.slice().reverse().forEach(function (w) {
      var row = document.createElement('div');
      row.className = 'shopping-item';
      row.innerHTML =
        '<span>' + w.data + ' — ' + w.waga + ' kg</span>' +
        '<button class="del-btn" title="Usuń"><span class="material-symbols-outlined">close</span></button>';
      row.querySelector('.del-btn').onclick = async function () {
        var ok = await pokazPotwierdzenie('Usunąć ten pomiar?');
        if (!ok) return;
        db.usunPomiarWagi(w.id).then(wczytajWage).catch(pokazBlad);
      };
      lista.appendChild(row);
    });
  }

  function renderujWykresWagi() {
    var el = document.getElementById('waga-wykres');
    if (state.wagaPomiary.length < 2) { el.innerHTML = ''; return; }
    var dane = state.wagaPomiary;
    var wartosci = dane.map(function (d) { return Number(d.waga); });
    var min = Math.min.apply(null, wartosci), max = Math.max.apply(null, wartosci);
    if (min === max) { min -= 1; max += 1; }
    var w = 300, h = 90, pad = 8;
    var pts = dane.map(function (d, i) {
      var x = pad + (w - 2 * pad) * (dane.length === 1 ? 0 : i / (dane.length - 1));
      var y = pad + (h - 2 * pad) * (1 - (Number(d.waga) - min) / (max - min));
      return x + ',' + y;
    }).join(' ');
    el.innerHTML =
      '<div class="card"><svg viewBox="0 0 ' + w + ' ' + h + '" style="width:100%; height:90px; display:block;">' +
      '<polyline points="' + pts + '" fill="none" stroke="var(--accent)" stroke-width="2"/></svg></div>';
  }

  function dodajPomiarWagiHandler() {
    var data = document.getElementById('waga-nowa-data').value;
    var wartosc = document.getElementById('waga-nowa-wartosc').value;
    if (!state.wagaOsoba) return;
    if (!data || !wartosc) { pokazKomunikat('Podaj datę i wagę.'); return; }
    db.dodajPomiarWagi(state.wagaOsoba, data, Number(wartosc)).then(function () {
      document.getElementById('waga-nowa-wartosc').value = '';
      wczytajWage();
    }).catch(pokazBlad);
  }
</script>
</body>
