  // ===================== ZDJĘCIA PRZEPISÓW (Supabase Storage) =====================
  const NAZWA_BUCKETU_ZDJEC = 'przepisy-zdjecia';
  const MAX_WYMIAR_ZDJECIA = 1000; // px, dłuższy bok
  const JAKOSC_ZDJECIA = 0.75; // 0-1, kompresja JPEG

  function zmniejszZdjecie(plik, maxWymiar, jakosc) {
    return new Promise(function (resolve, reject) {
      var url = URL.createObjectURL(plik);
      var img = new Image();
      img.onload = function () {
        URL.revokeObjectURL(url);
        var w = img.naturalWidth, h = img.naturalHeight;
        if (w > maxWymiar || h > maxWymiar) {
          if (w >= h) { h = Math.round(h * (maxWymiar / w)); w = maxWymiar; }
          else { w = Math.round(w * (maxWymiar / h)); h = maxWymiar; }
        }
        var canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        canvas.toBlob(function (blob) {
          if (blob) resolve(blob);
          else reject(new Error('Nie udało się przetworzyć zdjęcia.'));
        }, 'image/jpeg', jakosc);
      };
      img.onerror = function () {
        URL.revokeObjectURL(url);
        reject(new Error('Nie udało się wczytać zdjęcia.'));
      };
      img.src = url;
    });
  }

  async function wyslijZdjeciePrzepisu(plik) {
    var blob = await zmniejszZdjecie(plik, MAX_WYMIAR_ZDJECIA, JAKOSC_ZDJECIA);
    var sciezka = Date.now() + '-' + Math.round(Math.random() * 1e6) + '.jpg';
    const { error } = await sb.storage.from(NAZWA_BUCKETU_ZDJEC).upload(sciezka, blob, { upsert: true, contentType: 'image/jpeg' });
    if (error) throw error;
    const { data } = sb.storage.from(NAZWA_BUCKETU_ZDJEC).getPublicUrl(sciezka);
    return data.publicUrl;
  }

