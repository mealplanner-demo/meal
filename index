    currentRecipeId = id;
    document.getElementById('szczegoly-nazwa').innerText = p.nazwa;
    var hero = document.getElementById('szczegoly-zdjecie');
    if (p.zdjecieUrl) {
      hero.src = p.zdjecieUrl;
      hero.style.display = 'block';
    } else {
      hero.style.display = 'none';
    }
    document.getElementById('szczegoly-makro').innerHTML =
      '<div class="summary-card"><div class="label-sm">Kalorie</div><div class="num">' + p.kcal + '</div></div>' +
      '<div class="summary-card"><div class="label-sm">Makro</div><div class="macro" style="font-size:14px; margin-top:6px;">B ' + p.bialko + 'g · T ' + p.tluszcz + 'g · W ' + p.wegle + 'g</div></div>';
    var skl = document.getElementById('szczegoly-skladniki');
    skl.innerHTML = p.skladniki.length
      ? p.skladniki.map(function (s) { return '<div class="shopping-item"><span>' + s.nazwa + ' — ' + s.ilosc + ' ' + s.jednostka + '</span></div>'; }).join('')
      : '<p class="label-sm">Brak podanych składników.</p>';
